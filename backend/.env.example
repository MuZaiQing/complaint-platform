# Hadoop 集群（SSH）
CLUSTER_HOST=10.15.7.101
CLUSTER_PORT=22
CLUSTER_USER=hadoop
CLUSTER_PASSWORD=dsj123
CLUSTER_JAR_DIR=/home/hadoop/jars

# 本地 jar 目录
JAR_DIR=D:\fqh\jar包

# 1=不连集群，用内置假数据跑通页面（联调用）
CLUSTER_MOCK=0

# 非登录 shell 不会加载 ~/.bashrc，需显式注入 hadoop 环境变量（留空则用代码默认值）
CLUSTER_ENV=export JAVA_HOME=/home/hadoop/software/jdk-17.0.21+9; export HADOOP_HOME=/home/hadoop/software/hadoop-3.5.0; export PATH=$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$PATH;
